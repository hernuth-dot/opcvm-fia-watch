# Copie ce fichier en ".env" et remplis les valeurs. Ne commite jamais le ".env" lui-meme.

# --- Source GECO (liste publique des OPC de l'AMF) ---
GECO_URL=https://geco.amf-france.org/liste-des-produits-d-epargne

# --- Flux RSS des decisions AMF (agrements / retraits) ---
# Va sur https://bdif.amf-france.org/En-plus/Abonnements-et-flux-RSS , trouve le
# flux correspondant aux decisions OPCVM/FIA, et colle son URL ici.
AMF_RSS_URL=

# --- Base de donnees locale (SQLite) ---
DATABASE_PATH=data/funds.db

# --- Email (SMTP generique - fonctionne avec Brevo, Gmail avec mot de passe d'appli, etc.) ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=alerts@votre-domaine.fr
EMAIL_TO=vous@exemple.fr,associe2@exemple.fr,associe3@exemple.fr

# --- Rapport HTML (dashboard statique publie sur GitHub Pages) ---
REPORT_OUTPUT_PATH=docs/index.html
